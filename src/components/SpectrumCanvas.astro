---
interface Props {
  height?: string;
}
const { height = '100%' } = Astro.props;
---

<div class="spectrum-stage" style={`height: ${height};`} aria-hidden="true">
  <canvas id="spectrum-webgl-canvas"></canvas>
  <div class="spectrum-vignette"></div>
</div>

<script>
  import * as THREE from 'three';

  function initSpectrumCanvas() {
    const canvas = document.getElementById('spectrum-webgl-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    // Respect prefers-reduced-motion
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) {
      canvas.style.display = 'none';
      return;
    }

    // Avoid duplicate instances on Astro ViewTransition navigation
    if (canvas.dataset.initialized === 'true') return;
    canvas.dataset.initialized = 'true';

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
    } catch {
      return;
    }

    const parent = canvas.parentElement;
    const width = parent ? parent.clientWidth : window.innerWidth;
    const height = parent ? parent.clientHeight : window.innerHeight;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height, false);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(52, width / Math.max(height, 1), 0.1, 100);
    camera.position.set(0, 0.35, 5.2);

    // 1. Dynamic Spectral Ribbon (TorusKnot wireframe + glowing prism shader-like material)
    const prismGroup = new THREE.Group();
    scene.add(prismGroup);

    const knotGeo = new THREE.TorusKnotGeometry(1.45, 0.36, 180, 28, 2, 3);
    const knotMat = new THREE.MeshBasicMaterial({
      color: 0x38bdf8,
      wireframe: true,
      transparent: true,
      opacity: 0.24,
    });
    const knotMesh = new THREE.Mesh(knotGeo, knotMat);
    prismGroup.add(knotMesh);

    // Inner Octahedron Prism Core
    const coreGeo = new THREE.OctahedronGeometry(0.95, 1);
    const coreMat = new THREE.MeshBasicMaterial({
      color: 0xa78bfa,
      wireframe: true,
      transparent: true,
      opacity: 0.35,
    });
    const coreMesh = new THREE.Mesh(coreGeo, coreMat);
    prismGroup.add(coreMesh);

    // 2. Spectral Particle Field (5 wavelengths)
    const particleCount = 650;
    const positions = new Float32Array(particleCount * 3);
    const colors = new Float32Array(particleCount * 3);
    const palette = [
      new THREE.Color('#38bdf8'),
      new THREE.Color('#34d399'),
      new THREE.Color('#fbbf24'),
      new THREE.Color('#fb7185'),
      new THREE.Color('#a78bfa'),
    ];

    for (let i = 0; i < particleCount; i++) {
      const r = 1.6 + Math.random() * 4.2;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      positions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
      positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta) * 0.65;
      positions[i * 3 + 2] = r * Math.cos(phi);

      const c = palette[i % palette.length];
      colors[i * 3] = c.r;
      colors[i * 3 + 1] = c.g;
      colors[i * 3 + 2] = c.b;
    }

    const pGeo = new THREE.BufferGeometry();
    pGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    pGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const pMat = new THREE.PointsMaterial({
      size: 0.042,
      vertexColors: true,
      transparent: true,
      opacity: 0.82,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const particles = new THREE.Points(pGeo, pMat);
    scene.add(particles);

    // Interactive pointer parallax
    let targetX = 0;
    let targetY = 0;
    const onPointerMove = (e: PointerEvent) => {
      targetX = (e.clientX / window.innerWidth - 0.5) * 1.1;
      targetY = (e.clientY / window.innerHeight - 0.5) * 0.7;
    };
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    const onResize = () => {
      if (!canvas.isConnected) return;
      const w = parent ? parent.clientWidth : window.innerWidth;
      const h = parent ? parent.clientHeight : window.innerHeight;
      camera.aspect = w / Math.max(h, 1);
      camera.updateProjectionMatrix();
      renderer.setSize(w, h, false);
    };
    window.addEventListener('resize', onResize, { passive: true });

    let rafId = 0;
    const clock = new THREE.Clock();

    const animate = () => {
      if (!canvas.isConnected) {
        cancelAnimationFrame(rafId);
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('resize', onResize);
        renderer.dispose();
        return;
      }
      const t = clock.getElapsedTime();
      const scrollRatio = Math.min(window.scrollY / Math.max(window.innerHeight, 1), 2);

      prismGroup.rotation.x += (targetY * 0.45 + scrollRatio * 0.4 - prismGroup.rotation.x) * 0.04;
      prismGroup.rotation.y += (targetX * 0.55 + t * 0.16 - prismGroup.rotation.y) * 0.04;
      coreMesh.rotation.y = -t * 0.32;
      coreMesh.rotation.z = t * 0.18;

      particles.rotation.y = t * 0.05 + targetX * 0.2;
      particles.rotation.x = targetY * 0.15;

      // Subtle hue shift over time
      knotMat.color.setHSL((0.54 + Math.sin(t * 0.15) * 0.08) % 1, 0.85, 0.62);

      renderer.render(scene, camera);
      rafId = requestAnimationFrame(animate);
    };

    animate();
  }

  document.addEventListener('astro:page-load', initSpectrumCanvas);
</script>

<style>
  .spectrum-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  #spectrum-webgl-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  .spectrum-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 55% 40%, transparent 20%, rgba(6, 7, 10, 0.85) 82%);
  }
</style>
