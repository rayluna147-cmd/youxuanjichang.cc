---
import { SITE } from '../data/site';
import BrandLogo from './BrandLogo.astro';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <BrandLogo />
      <p class="footer-desc">{SITE.description}</p>
      <div class="footer-badges">
        <span class="pill">SPECTRUM 动态光谱</span>
        <span class="pill">白名单零虚构原则</span>
      </div>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading mono">CORE / 核心频道</h3>
      <ul>
        {SITE.footerLinks.core.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading mono">TOPICS / 细分专题</h3>
      <ul>
        {SITE.footerLinks.topics.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading mono">SYSTEM / 站点与协议</h3>
      <ul>
        {SITE.footerLinks.system.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <span class="mono">© 2026 优选机场 (YOUXUAN / YX.) · youxuanjichang.cc</span>
    <span class="mono">BUILT WITH ASTRO · GSAP · THREE.JS · PAGEFIND</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--border-hairline);
    background: linear-gradient(180deg, rgba(13, 16, 23, 0.4), rgba(6, 7, 10, 0.98));
    padding: 4.5rem 0 2.5rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
  }
  .footer-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 1rem 0 1.25rem;
    max-width: 42ch;
  }
  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer-heading {
    font-size: 0.74rem;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-col a {
    font-size: 0.92rem;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }
  .footer-col a:hover {
    color: var(--spectrum-accent);
  }
  .footer-bottom {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-hairline);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
