---
import { SITE } from '../data/site';
import BrandLogo from './BrandLogo.astro';

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <BrandLogo />

    <nav class="desktop-nav" aria-label="主导航">
      {
        SITE.nav.slice(0, 6).map((item) => {
          const isActive = currentPath === item.href || currentPath.startsWith(item.href);
          return (
            <a href={item.href} class:list={['nav-link', { active: isActive }]}>
              <span>{item.label}</span>
              {'badge' in item && item.badge && <span class="nav-badge mono">{item.badge}</span>}
            </a>
          );
        })
      }
    </nav>

    <div class="header-actions">
      <a href="/search/" class="icon-btn" aria-label="全文搜索" title="全文搜索">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7" />
          <line x1="16.65" y1="16.65" x2="21" y2="21" />
        </svg>
      </a>
      <button
        type="button"
        class="menu-trigger"
        id="menu-trigger"
        aria-expanded="false"
        aria-controls="fullscreen-menu"
        aria-label="打开全屏光谱导航"
      >
        <span class="mono menu-label">MENU</span>
        <span class="menu-bars" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Fullscreen Dynamic Spectrum Menu -->
<div class="fullscreen-menu" id="fullscreen-menu" aria-hidden="true">
  <div class="container menu-grid">
    <div class="menu-links-col">
      <div class="eyebrow">SPECTRUM NAVIGATION</div>
      <ul class="menu-list">
        {
          SITE.nav.map((item, idx) => (
            <li class="menu-item">
              <a href={item.href} class="menu-big-link">
                <span class="menu-idx mono">0{idx + 1}</span>
                <span class="menu-cn">{item.label}</span>
                <span class="menu-en mono">{item.en}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="menu-meta-col">
      <div class="panel menu-card">
        <div class="eyebrow">核心专题直达</div>
        <div class="topic-quick-links">
          {
            SITE.footerLinks.topics.map((t) => (
              <a href={t.href} class="topic-quick-link">
                {t.label} →
              </a>
            ))
          }
        </div>
      </div>
      <div class="menu-footnote mono">
        <span>DOMAIN: youxuanjichang.cc</span>
        <span>POLICY: STRICT WHITELIST · ZERO FABRICATION</span>
      </div>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 0.9rem 0;
    background: rgba(6, 7, 10, 0.72);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-hairline);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.35rem;
  }
  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
    }
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--text-secondary);
    transition: color 0.25s ease, background-color 0.25s ease;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.06);
  }
  .nav-badge {
    font-size: 0.62rem;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--spectrum-cobalt) 20%, transparent);
    color: var(--spectrum-cobalt);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    position: relative;
    z-index: 60;
  }
  .icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--border-hairline);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition: border-color 0.25s ease, color 0.25s ease;
  }
  .icon-btn:hover {
    border-color: var(--spectrum-accent);
    color: var(--text-primary);
  }
  .menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 1.05rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    cursor: pointer;
    font-size: 0.78rem;
  }
  .menu-bars {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 18px;
  }
  .menu-bars span {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s var(--ease-expo);
  }
  .menu-trigger[aria-expanded='true'] .menu-bars span:first-child {
    transform: translateY(2.75px) rotate(45deg);
  }
  .menu-trigger[aria-expanded='true'] .menu-bars span:last-child {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  /* Fullscreen Menu */
  .fullscreen-menu {
    position: fixed;
    inset: 0;
    z-index: 45;
    background: rgba(6, 7, 10, 0.96);
    backdrop-filter: blur(24px);
    display: flex;
    align-items: flex-start;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-16px);
    transition: opacity 0.4s var(--ease-expo), transform 0.45s var(--ease-expo);
    padding-top: 5.5rem;
    overflow-y: auto;
  }
  .fullscreen-menu.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .menu-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: 2rem;
  }
  @media (min-width: 960px) {
    .menu-grid {
      grid-template-columns: 1.35fr 0.85fr;
      align-items: end;
    }
  }
  .menu-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .menu-big-link {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border-hairline);
    transition: padding-left 0.3s var(--ease-expo), color 0.25s ease;
  }
  .menu-big-link:hover {
    padding-left: 0.85rem;
    color: var(--spectrum-accent);
  }
  .menu-idx {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .menu-cn {
    font-size: clamp(1.5rem, 3.2vw, 2.5rem);
    font-weight: 800;
  }
  .menu-en {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .menu-card {
    padding: 1.6rem;
  }
  .topic-quick-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .topic-quick-link {
    color: var(--text-secondary);
    font-size: 0.95rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .topic-quick-link:hover {
    color: var(--spectrum-accent);
    transform: translateX(4px);
  }
  .menu-footnote {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.72rem;
    color: var(--text-muted);
  }
</style>
