---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBrandBySlug } from '../../data/brands';
import { buildArticleSchema, buildBreadcrumbSchema, buildCanonical } from '../../lib/seo';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews', ({ data }) => !data.draft);
  return reviews.map((review) => ({
    params: { slug: review.slug },
    props: { review },
  }));
}

interface Props {
  review: CollectionEntry<'reviews'>;
}

const { review } = Astro.props;
const brand = getBrandBySlug(review.data.brandSlug);
const { Content, headings } = await review.render();
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const canonicalUrl = buildCanonical(`/reviews/${review.slug}/`);
const schemas = [
  buildBreadcrumbSchema([
    { name: '首页', url: '/' },
    { name: '独立深度评测', url: '/reviews/' },
    { name: review.data.title, url: `/reviews/${review.slug}/` },
  ]),
  buildArticleSchema({
    title: review.data.title,
    description: review.data.description,
    url: canonicalUrl,
    publishedAt: review.data.publishedAt,
    updatedAt: review.data.updatedAt,
  }),
];
---

<BaseLayout title={review.data.title} description={review.data.description} ogType="article" schemas={schemas}>
  <article data-accent-section={review.data.accent}>
    <header class="review-hero">
      <div class="container">
        <div class="eyebrow">
          {brand ? `RANK #${brand.rank} · 独立深度评测` : '独立深度评测'}
        </div>
        <h1 class="display-lg" style="margin-top: 0.85rem; max-width: 26ch;">{review.data.title}</h1>
        <p class="review-lead">{review.data.description}</p>
        <div class="review-meta mono">
          <span>更新日期：{review.data.updatedAt}</span>
          <span>资料来源：{review.data.source}</span>
          {brand?.couponCode && <span>专属优惠码：{brand.couponCode}</span>}
        </div>
        {
          brand && (
            <div style="display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 1.4rem;">
              <a
                href={brand.affiliateUrl}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="btn btn-primary"
                data-magnetic
              >
                直达 {brand.name} 官网（优惠码 {brand.couponCode}）↗
              </a>
              <a href={`/brands/${brand.slug}/`} class="btn">查看品牌档案</a>
            </div>
          )
        }
      </div>
    </header>

    <div class="container review-layout">
      <div class="prose">
        <Content />
      </div>

      <aside class="toc-aside" aria-label="评测自动目录">
        <div class="panel toc-card">
          <div class="mono toc-title">REVIEW TOC / 评测目录</div>
          <nav class="toc-nav">
            {
              tocHeadings.map((h) => (
                <a href={`#${h.slug}`} class:list={['toc-link', { 'toc-sub': h.depth === 3 }]}>
                  {h.text}
                </a>
              ))
            }
          </nav>
          {
            brand && (
              <div class="toc-cta">
                <a
                  href={brand.affiliateUrl}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  class="btn btn-primary"
                  style="width: 100%; font-size: 0.84rem;"
                >
                  去 {brand.name} 看看 ↗
                </a>
              </div>
            )
          }
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .review-hero { padding: 4rem 0 2.5rem; border-bottom: 1px solid var(--border-hairline); }
  .review-lead { color: var(--text-secondary); font-size: 1.06rem; max-width: 66ch; margin: 1rem 0; }
  .review-meta { display: flex; flex-wrap: wrap; gap: 1.2rem; font-size: 0.76rem; color: var(--text-muted); }
  .review-layout { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-top: 2.5rem; }
  @media (min-width: 1060px) {
    .review-layout { grid-template-columns: minmax(0, 1fr) 300px; align-items: start; }
    .toc-aside { position: sticky; top: 6.5rem; }
  }
  .toc-card { padding: 1.4rem; }
  .toc-title { font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.9rem; }
  .toc-nav { display: flex; flex-direction: column; gap: 0.55rem; }
  .toc-link { font-size: 0.86rem; color: var(--text-secondary); }
  .toc-link:hover { color: var(--spectrum-accent); }
  .toc-sub { padding-left: 0.9rem; font-size: 0.82rem; color: var(--text-muted); }
  .toc-cta { margin-top: 1.4rem; padding-top: 1.1rem; border-top: 1px solid var(--border-hairline); }
</style>
