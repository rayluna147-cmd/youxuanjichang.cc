---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAuthorizedBrands, SPECTRUM_DIMENSIONS } from '../../data/brands';
import { TOPIC_HUBS } from '../../data/topics';
import { buildBreadcrumbSchema, buildFaqSchema } from '../../lib/seo';

const brands = getAuthorizedBrands();
const articles = (await getCollection('articles', ({ data }) => !data.draft)).slice(0, 6);

const selectFaq = [
  {
    q: '2026 年做机场推荐时，最核心的筛选标准是什么？',
    a: '核心看五项：跨境链路架构（是否真实 IEPL/IPLC 或优质 BGP 中转）、晚高峰 20:00–23:00 丢包与单线程吞吐、流媒体与 AI 工具 IP 纯净度、Clash/Sing-box 协议生态，以及每 100GB 折算单价的透明度。',
  },
  {
    q: '为什么优选机场目前没有直接罗列几十家“排行榜”？',
    a: '本站坚持独立白名单与零虚构原则：只收录经项目方明确授权且具备完整真实套餐、来源与实测资料的品牌，绝不搬运未经核验的旧站数据或编造测速评分。',
  },
  {
    q: '新手应该选择月付、年付还是不限时按量套餐？',
    a: '首次使用任何新品牌都建议先买月付或小额按量，连续验证晚高峰稳定性至少两周；成熟用户推荐“一家主力月付 + 一家不限时按量备用”的 80/20 双线组合。',
  },
];

const schemas = [
  buildBreadcrumbSchema([
    { name: '首页', url: '/' },
    { name: '机场推荐', url: '/select/' },
  ]),
  buildFaqSchema(selectFaq),
];
---

<BaseLayout
  title="2026 机场推荐核心指南 — 按场景、线路与预算精准选型"
  description="优选机场核心竞争专题：面向 2026 年中国大陆宽带环境，按 IEPL/IPLC 专线、AI 工具防风控、4K 流媒体解锁与性价比预算拆解机场推荐逻辑，提供交互式场景选型器与白名单档案。"
  schemas={schemas}
>
  <section class="page-hero" data-accent-section="#38bdf8">
    <div class="container">
      <div class="eyebrow">CORE COMPETITIVE HUB · /SELECT/</div>
      <h1 class="display-xl" style="margin-top: 0.9rem;">
        2026 <span class="spectrum-text">机场推荐</span>与选型中枢
      </h1>
      <p class="lead">
        不靠噱头榜单替你盲选。在这里，你可以按自己的真实使用场景、宽带运营商与月度预算，直接定位最匹配的线路架构、防踩坑要点与白名单核验品牌。
      </p>
    </div>
  </section>

  <!-- Interactive Scenario Selector -->
  <section class="section-sm" data-accent-section="#34d399">
    <div class="container">
      <div class="eyebrow">INTERACTIVE SELECTOR · 按场景匹配线路架构</div>
      <h2 class="display-md" style="margin: 0.7rem 0 1.4rem;">选择你的首要使用场景</h2>

      <div class="scenario-tabs" role="tablist" aria-label="使用场景切换">
        <button class="scenario-tab active" data-scenario="ai" type="button">AI 编程与办公（ChatGPT / Claude / Cursor）</button>
        <button class="scenario-tab" data-scenario="stream" type="button">4K 流媒体观影（Netflix / Disney+ / YouTube）</button>
        <button class="scenario-tab" data-scenario="light" type="button">轻度检索 / 学生党 / 应急备用</button>
        <button class="scenario-tab" data-scenario="heavy" type="button">多设备家庭 / 高频大流量</button>
      </div>

      <div class="panel scenario-output" id="scenario-output">
        <div class="scenario-grid">
          <div>
            <span class="pill" id="sc-badge">推荐架构：IEPL 专线 + AI 纯净落地</span>
            <h3 class="display-md" id="sc-title" style="margin-top: 0.85rem;">AI 生产力工具防风控方案</h3>
            <p id="sc-desc" class="sc-desc">
              AI 平台对出口 IP 纯净度与地区稳定性要求最高。务必避开香港节点，优先选择提供美国/日本/新加坡纯净落地或双 ISP 出口的 IEPL 专线，并在客户端建立独立策略组手动固定节点。
            </p>
          </div>
          <div class="sc-meta">
            <div class="sc-kv"><span>建议月预算</span><strong class="mono" id="sc-budget">¥30 – ¥50 / 月</strong></div>
            <div class="sc-kv"><span>关键核验项</span><strong id="sc-check">IP 欺诈分、非香港落地、晚高峰低抖动</strong></div>
            <a href="/topics/ai-tools-network/" id="sc-link" class="btn btn-primary" style="margin-top: 0.6rem;">进入对应深度专题 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Whitelist Brands Section -->
  <section class="section-sm" data-accent-section="#a78bfa">
    <div class="container">
      <div class="eyebrow">AUTHORIZED WHITELIST · 正式授权品牌列表</div>
      <h2 class="display-md" style="margin: 0.7rem 0 1.2rem;">已核验品牌（当前：{brands.length} 家）</h2>
      {
        brands.length > 0 ? (
          <div class="grid-3">
            {brands.map((b) => (
              <a href={`/brands/${b.slug}/`} class="panel card-pad">
                <h3>{b.name}</h3>
                <p>{b.tagline}</p>
              </a>
            ))}
          </div>
        ) : (
          <div class="panel notice-box">
            <p>
              <strong>零虚构声明：</strong>当前项目仓库尚未导入正式授权的商业品牌资料，因此此处保持空表，不展示任何虚构或未经授权的商家。
              你可以先使用 <a href="/plans/">套餐价格工作台</a> 测算预算，或阅读下方 5 大细分专题建立完整选型标准。
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- 5 Dimensions Quick Matrix -->
  <section class="section-sm" data-accent-section="#fbbf24">
    <div class="container">
      <div class="eyebrow">SPECTRUM MATRIX · 五维选型核验清单</div>
      <h2 class="display-md" style="margin: 0.7rem 0 1.5rem;">下单前必须核对的 5 个维度</h2>
      <div class="grid-3">
        {
          SPECTRUM_DIMENSIONS.map((d) => (
            <div class="panel card-pad">
              <div class="mono" style={`color: ${d.accent}; font-size: 0.75rem;`}>{d.code}</div>
              <h3 style="margin: 0.5rem 0;">{d.title}</h3>
              <p style="color: var(--text-secondary); font-size: 0.92rem; margin: 0;">{d.summary}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Topic Hubs & Related Articles -->
  <section class="section-sm">
    <div class="container">
      <div class="eyebrow">CLUSTER LINKS · 延伸专题与原创指南</div>
      <h2 class="display-md" style="margin: 0.7rem 0 1.5rem;">按技术主题深入探索</h2>
      <div class="grid-3">
        {
          TOPIC_HUBS.map((t) => (
            <a href={`/topics/${t.slug}/`} class="panel card-pad">
              <span class="mono" style={`color: ${t.accent}; font-size: 0.72rem;`}>{t.code}</span>
              <h3 style="margin: 0.45rem 0;">{t.title}</h3>
              <p style="color: var(--text-secondary); font-size: 0.9rem; margin: 0;">{t.description}</p>
            </a>
          ))
        }
      </div>

      <h3 class="display-md" style="margin: 3rem 0 1.2rem;">必读原创指南</h3>
      <div class="grid-3">
        {
          articles.map((a) => (
            <a href={`/articles/${a.slug}/`} class="panel card-pad">
              <span class="mono" style="font-size: 0.72rem; color: var(--text-muted);">{a.data.category}</span>
              <h4 style="margin: 0.45rem 0; font-size: 1.05rem;">{a.data.title}</h4>
              <span class="mono" style="font-size: 0.75rem; color: var(--spectrum-accent);">阅读全文 →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-sm">
    <div class="container">
      <div class="eyebrow">FAQ · 常见问题</div>
      <h2 class="display-md" style="margin: 0.7rem 0 1.4rem;">关于机场推荐的常见疑问</h2>
      <div class="faq-list">
        {
          selectFaq.map((item) => (
            <details class="panel faq-item" open>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const SCENARIOS: Record<string, { badge: string; title: string; desc: string; budget: string; check: string; link: string }> = {
    ai: {
      badge: '推荐架构：IEPL 专线 + AI 纯净落地',
      title: 'AI 生产力工具防风控方案',
      desc: 'AI 平台对出口 IP 纯净度与地区稳定性要求最高。务必避开香港节点，优先选择提供美国/日本/新加坡纯净落地或双 ISP 出口的 IEPL 专线，并在客户端建立独立策略组手动固定节点。',
      budget: '¥30 – ¥50 / 月',
      check: 'IP 欺诈分、非香港落地、晚高峰低抖动',
      link: '/topics/ai-tools-network/',
    },
    stream: {
      badge: '推荐架构：原生 IP / DNS 全解锁专线',
      title: '4K 流媒体无缓冲观影方案',
      desc: '观看 Netflix 非自制剧、Disney+ 与 YouTube 4K 60fps，需要晚高峰单线程带宽稳定超过 50Mbps。华语字幕首选新加坡/台湾/香港，动漫首选日本，美剧全库首选美国。',
      budget: '¥28 – ¥60 / 月',
      check: 'Netflix 非自制剧解锁、50Mbps+ 单线程、低丢包',
      link: '/topics/streaming-unlock/',
    },
    light: {
      badge: '推荐架构：优质 BGP 中转 或 不限时按量',
      title: '轻度检索与高性价比备用方案',
      desc: '月消耗低于 30GB 优先考虑不限时按量套餐，避免月底流量清零浪费；月消耗 50–100GB 可选三线 BGP 中转月付，兼顾电信/联通/移动宽带体验。',
      budget: '¥15 – ¥25 / 月（或按量）',
      check: '每 100GB 折算单价、客户端一键托管、无隐形倍率',
      link: '/plans/',
    },
    heavy: {
      badge: '推荐架构：大流量 IEPL 专线 + 按量备用双线',
      title: '多设备家庭与高频大流量方案',
      desc: '多设备并发或高频下载需重点核验同时在线设备数限制、节点倍率（优先 1x）与真实带宽上限，建议搭配一家不限时按量机场作为应急备用。',
      budget: '¥60 – ¥120 / 月',
      check: '设备数限制、1x 倍率专线、双线冗余',
      link: '/topics/iepl-iplc/',
    },
  };

  function bindScenarios() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.scenario-tab');
    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.scenario || 'ai';
        const data = SCENARIOS[key];
        if (!data) return;
        tabs.forEach((t) => t.classList.remove('active'));
        btn.classList.add('active');
        const set = (id: string, val: string) => {
          const el = document.getElementById(id);
          if (el) el.textContent = val;
        };
        set('sc-badge', data.badge);
        set('sc-title', data.title);
        set('sc-desc', data.desc);
        set('sc-budget', data.budget);
        set('sc-check', data.check);
        const link = document.getElementById('sc-link') as HTMLAnchorElement | null;
        if (link) link.href = data.link;
      });
    });
  }

  document.addEventListener('astro:page-load', bindScenarios);
</script>

<style>
  .page-hero {
    padding: 4rem 0 2.5rem;
  }
  .lead {
    color: var(--text-secondary);
    font-size: 1.08rem;
    max-width: 66ch;
    margin-top: 1.2rem;
  }
  .section-sm {
    padding: 2.8rem 0;
  }
  .scenario-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-bottom: 1.25rem;
  }
  .scenario-tab {
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    border: 1px solid var(--border-hairline);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.25s ease;
  }
  .scenario-tab.active,
  .scenario-tab:hover {
    border-color: var(--spectrum-accent);
    color: var(--text-primary);
    background: color-mix(in srgb, var(--spectrum-accent) 14%, transparent);
  }
  .scenario-output {
    padding: 1.8rem;
  }
  .scenario-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.8rem;
  }
  @media (min-width: 860px) {
    .scenario-grid {
      grid-template-columns: 1.4fr 0.8fr;
      align-items: center;
    }
  }
  .sc-desc {
    color: var(--text-secondary);
    margin: 0.8rem 0 0;
  }
  .sc-meta {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-left: 0;
  }
  @media (min-width: 860px) {
    .sc-meta {
      padding-left: 1.8rem;
      border-left: 1px solid var(--border-hairline);
    }
  }
  .sc-kv {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.88rem;
  }
  .sc-kv span {
    color: var(--text-muted);
    font-size: 0.78rem;
  }
  .notice-box {
    padding: 1.5rem;
    color: var(--text-secondary);
  }
  .notice-box a {
    color: var(--spectrum-accent);
    text-decoration: underline;
  }
  .grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }
  @media (min-width: 860px) {
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .card-pad {
    padding: 1.45rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .faq-item {
    padding: 1.2rem 1.4rem;
  }
  .faq-item summary {
    font-weight: 700;
    cursor: pointer;
  }
  .faq-item p {
    color: var(--text-secondary);
    margin: 0.8rem 0 0;
  }
</style>
