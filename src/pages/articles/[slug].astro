---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildArticleSchema, buildBreadcrumbSchema, buildCanonical, buildFaqSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content, headings } = await article.render();
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const canonicalUrl = buildCanonical(`/articles/${article.slug}/`);
const schemas: Record<string, unknown>[] = [
  buildBreadcrumbSchema([
    { name: '首页', url: '/' },
    { name: '专题指南', url: '/guides/' },
    { name: article.data.title, url: `/articles/${article.slug}/` },
  ]),
  buildArticleSchema({
    title: article.data.title,
    description: article.data.description,
    url: canonicalUrl,
    publishedAt: article.data.publishedAt,
    updatedAt: article.data.updatedAt,
    keywords: article.data.keywords,
  }),
];
if (article.data.faq && article.data.faq.length > 0) {
  schemas.push(buildFaqSchema(article.data.faq));
}
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  ogType="article"
  schemas={schemas}
>
  <article class="article-shell" data-accent-section={article.data.accent}>
    <header class="article-hero">
      <div class="container">
        <div class="eyebrow">{article.data.category} · {article.data.readingMinutes} MIN READ</div>
        <h1 class="display-lg" style="margin-top: 0.9rem; max-width: 24ch;">{article.data.title}</h1>
        <p class="article-lead">{article.data.description}</p>
        <div class="article-meta mono">
          <span>发布：{article.data.publishedAt}</span>
          <span>更新：{article.data.updatedAt}</span>
          <span>作者：优选机场编辑部</span>
        </div>
      </div>
    </header>

    <div class="container article-layout">
      <div class="prose">
        <Content />

        {
          article.data.faq && article.data.faq.length > 0 && (
            <section class="article-faq">
              <h2>常见问题解答（FAQ）</h2>
              {article.data.faq.map((item) => (
                <details class="panel faq-box" open>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))}
            </section>
          )
        }
      </div>

      <aside class="toc-aside" aria-label="文章自动目录">
        <div class="panel toc-card">
          <div class="mono toc-title">ON THIS PAGE / 自动目录</div>
          <nav class="toc-nav">
            {
              tocHeadings.map((h) => (
                <a href={`#${h.slug}`} class:list={['toc-link', { 'toc-sub': h.depth === 3 }]}>
                  {h.text}
                </a>
              ))
            }
          </nav>
          <div class="toc-cta">
            <a href="/select/" class="btn" style="width: 100%; font-size: 0.85rem;">返回机场推荐中枢 →</a>
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .article-hero { padding: 4rem 0 2.5rem; border-bottom: 1px solid var(--border-hairline); }
  .article-lead { color: var(--text-secondary); font-size: 1.08rem; max-width: 66ch; margin: 1.1rem 0; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 1.2rem; font-size: 0.76rem; color: var(--text-muted); }
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-top: 2.5rem;
  }
  @media (min-width: 1060px) {
    .article-layout { grid-template-columns: minmax(0, 1fr) 300px; align-items: start; }
    .toc-aside { position: sticky; top: 6.5rem; }
  }
  .toc-card { padding: 1.4rem; }
  .toc-title { font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.9rem; }
  .toc-nav { display: flex; flex-direction: column; gap: 0.55rem; }
  .toc-link { font-size: 0.86rem; color: var(--text-secondary); transition: color 0.2s ease; }
  .toc-link:hover { color: var(--spectrum-accent); }
  .toc-sub { padding-left: 0.9rem; font-size: 0.82rem; color: var(--text-muted); }
  .toc-cta { margin-top: 1.4rem; padding-top: 1.1rem; border-top: 1px solid var(--border-hairline); }
  .faq-box { padding: 1rem 1.25rem; margin-bottom: 0.85rem; }
  .faq-box summary { font-weight: 700; cursor: pointer; }
  .faq-box p { margin: 0.65rem 0 0; }
</style>
