---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SpectrumCanvas from '../components/SpectrumCanvas.astro';
import { getAuthorizedBrands, SPECTRUM_DIMENSIONS } from '../data/brands';
import { TOPIC_HUBS } from '../data/topics';
import { WHITELIST_META } from '../data/whitelist';

const brands = getAuthorizedBrands();
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.updatedAt).getTime() - new Date(a.data.updatedAt).getTime()
);
const featuredArticles = articles.filter((a) => a.data.featured).slice(0, 3);
---

<BaseLayout
  title="优选机场 (YOUXUAN) — SPECTRUM 动态光谱 · 机场推荐、IEPL 专线与套餐对比"
  description="优选机场（youxuanjichang.cc）以 SPECTRUM 动态光谱五维评测体系，提供中立透明的机场推荐指南、IEPL/IPLC 专线解析、流媒体与 AI 工具网络优化、以及交互式套餐性价比对比工具。"
>
  <!-- 01. HERO: 3D SPECTRUM INSTALLATION + ASYMMETRIC EDITORIAL LAYOUT -->
  <section class="hero" data-accent-section="#38bdf8">
    <SpectrumCanvas />
    <div class="container hero-grid">
      <div class="hero-main">
        <div class="eyebrow">SPECTRUM 动态光谱 · 2026 独立网络评测</div>
        <h1 class="display-xl hero-title">
          穿透营销迷雾，<br />
          <span class="spectrum-text">重构机场选型光谱</span>
        </h1>
        <p class="hero-lead">
          优选机场（YOUXUAN / YX.）拒绝虚假测速图与暗箱返佣榜单。我们以五维光谱体系拆解 IEPL/IPLC
          专线、流媒体原生 IP、AI 工具防风控与每 100GB 真实单价，只收录经白名单核验的真实品牌。
        </p>
        <div class="hero-cta">
          <a href="/select/" class="btn btn-primary" data-magnetic>进入机场推荐核心专题 →</a>
          <a href="/plans/" class="btn" data-magnetic>打开套餐价格工作台</a>
        </div>
      </div>

      <aside class="hero-aside panel" data-tilt-card>
        <div class="aside-head mono">
          <span>SYSTEM TELEMETRY</span>
          <span class="live-dot">LIVE</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">白名单核验原则</span>
          <span class="stat-val mono">ZERO FABRICATION</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">当前授权品牌</span>
          <span class="stat-val mono">{brands.length} / 待导入真实资料</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">原创技术专题与指南</span>
          <span class="stat-val mono">{TOPIC_HUBS.length} 专题 · {articles.length} 深度长文</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">最后审计日期</span>
          <span class="stat-val mono">{WHITELIST_META.lastAuditedAt}</span>
        </div>
        <a href="/about/#whitelist-standard" class="aside-link mono">查看白名单准入标准 ↗</a>
      </aside>
    </div>
  </section>

  <!-- 02. STICKY NARRATIVE: 5-WAVELENGTH EVALUATION SPECTRUM -->
  <section class="section sticky-section" data-accent-section="#a78bfa">
    <div class="container sticky-grid">
      <div class="sticky-left">
        <div class="eyebrow">02 / EVALUATION SPECTRUM</div>
        <h2 class="display-lg" style="margin-top: 0.9rem;">
          五道光谱，<br />拆解真实网络质量
        </h2>
        <p class="section-desc">
          单看凌晨多线程测速毫无意义。我们将每一条跨境线路折射为五个可独立核验的维度，帮你建立不依赖任何榜单的判断力。
        </p>

        <!-- Animated SVG Spectral Refraction Path -->
        <svg class="spectral-wave" viewBox="0 0 360 110" fill="none" aria-hidden="true">
          <path
            data-svg-draw
            d="M4 70 C 55 15, 115 105, 175 55 C 235 5, 295 95, 356 35"
            stroke="#38bdf8"
            stroke-width="2"
            opacity="0.85"
          />
          <path
            data-svg-draw
            d="M4 85 C 65 35, 125 95, 190 48 C 250 10, 305 80, 356 52"
            stroke="#a78bfa"
            stroke-width="1.6"
            opacity="0.7"
          />
          <path
            data-svg-draw
            d="M4 55 C 70 95, 130 20, 200 66 C 260 100, 310 30, 356 68"
            stroke="#fb7185"
            stroke-width="1.2"
            opacity="0.55"
          />
        </svg>

        <a href="/select/" class="btn" data-magnetic>查看完整选型指南 →</a>
      </div>

      <div class="sticky-right">
        {
          SPECTRUM_DIMENSIONS.map((dim) => (
            <article class="dim-card panel" data-reveal data-tilt-card style={`--dim-accent: ${dim.accent};`}>
              <div class="dim-top">
                <span class="mono dim-code">{dim.code}</span>
                <span class="pill">{dim.wavelength}</span>
              </div>
              <h3 class="dim-title">{dim.title}</h3>
              <div class="dim-en mono">{dim.enTitle}</div>
              <p class="dim-summary">{dim.summary}</p>
              <ul class="dim-metrics">
                {dim.metrics.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 03. DYNAMIC BRAND GALLERY / WHITELIST VERIFICATION STAGE -->
  <section class="section" data-accent-section="#34d399">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">03 / BRAND WHITELIST GALLERY</div>
          <h2 class="display-lg" style="margin-top: 0.8rem;">品牌白名单动态展廊</h2>
        </div>
        <div class="head-actions">
          <a href="/brands/" class="btn" data-magnetic>品牌档案库</a>
          <a href="/compare/" class="btn" data-magnetic>横向对比工具</a>
        </div>
      </div>

      {
        brands.length > 0 ? (
          <div class="brand-gallery">
            {brands.map((brand) => (
              <a href={`/brands/${brand.slug}/`} class="panel brand-card" data-tilt-card>
                <div class="mono" style={`color: ${brand.accentColor};`}>{brand.enName}</div>
                <h3 class="display-md">{brand.name}</h3>
                <p>{brand.tagline}</p>
              </a>
            ))}
          </div>
        ) : (
          <div class="whitelist-stage panel" data-reveal>
            <div class="whitelist-badge mono">STRICT WHITELIST · ZERO FABRICATION</div>
            <h3 class="display-md">当前处于独立项目初始化阶段 · 严禁虚构品牌与测速</h3>
            <p class="whitelist-copy">
              优选机场（youxuanjichang.cc）严格遵守独立品牌白名单制度：<strong>绝不继承旧站未经授权的推广链接，绝不虚构任何品牌的套餐价格、测速截图、评分或成立资历</strong>。
              在正式品牌资料导入 <code>src/data/whitelist.ts</code> 之前，你可以先使用本站完整可用的选型指南、套餐性价比测算工作台与五大细分技术专题。
            </p>
            <div class="whitelist-actions">
              <a href="/plans/" class="btn btn-primary" data-magnetic>体验套餐价格测算工作台 →</a>
              <a href="/brands/" class="btn" data-magnetic>查看白名单准入结构</a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- 04. ASYMMETRIC TOPIC HUBS & EDITORIAL MAGAZINE -->
  <section class="section" data-accent-section="#fbbf24">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">04 / TOPIC CLUSTERS &amp; EDITORIAL</div>
          <h2 class="display-lg" style="margin-top: 0.8rem;">细分专题与原创深度指南</h2>
        </div>
        <a href="/guides/" class="btn" data-magnetic>浏览全部专题 →</a>
      </div>

      <div class="topics-mosaic">
        {
          TOPIC_HUBS.map((topic, i) => (
            <a
              href={`/topics/${topic.slug}/`}
              class:list={['panel topic-tile', { 'tile-wide': i === 0 || i === 3 }]}
              data-reveal
              data-tilt-card
              style={`--tile-accent: ${topic.accent};`}
            >
              <span class="mono topic-code">{topic.code}</span>
              <h3 class="topic-title">{topic.shortTitle}</h3>
              <p class="topic-desc">{topic.description}</p>
              <span class="topic-kw mono">CORE: {topic.targetKeyword} →</span>
            </a>
          ))
        }
      </div>

      <div class="articles-strip">
        {
          featuredArticles.map((article) => (
            <a href={`/articles/${article.slug}/`} class="panel article-card" data-reveal>
              <div class="article-meta mono">
                <span>{article.data.category}</span>
                <span>{article.data.readingMinutes} MIN READ</span>
              </div>
              <h3 class="article-title">{article.data.title}</h3>
              <p class="article-desc">{article.data.description}</p>
              <span class="article-more mono">阅读全文 →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 4.6rem);
    display: flex;
    align-items: center;
    padding: 4.5rem 0 5rem;
    overflow: hidden;
  }
  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.45fr 0.75fr;
    }
  }
  .hero-title {
    margin-top: 1.1rem;
  }
  .hero-lead {
    margin: 1.6rem 0 2.2rem;
    max-width: 58ch;
    color: var(--text-secondary);
    font-size: 1.08rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .hero-aside {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .aside-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--text-muted);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-hairline);
  }
  .live-dot {
    color: var(--spectrum-emerald);
  }
  .stat-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .stat-val {
    font-size: 0.88rem;
    color: var(--text-primary);
  }
  .aside-link {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--spectrum-accent);
  }

  .section {
    padding: 5.5rem 0;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .head-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .section-desc {
    color: var(--text-secondary);
    margin: 1.2rem 0 1.8rem;
    max-width: 44ch;
  }

  /* Sticky Narrative */
  .sticky-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 960px) {
    .sticky-grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
    .sticky-left {
      position: sticky;
      top: 7rem;
    }
  }
  .spectral-wave {
    width: 100%;
    max-width: 360px;
    margin: 1.5rem 0 2rem;
  }
  .sticky-right {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .dim-card {
    padding: 1.8rem;
    border-left: 3px solid var(--dim-accent, var(--spectrum-accent));
  }
  .dim-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }
  .dim-code {
    font-size: 0.78rem;
    color: var(--dim-accent);
  }
  .dim-title {
    font-size: 1.4rem;
    margin: 0;
  }
  .dim-en {
    font-size: 0.74rem;
    color: var(--text-muted);
    margin: 0.25rem 0 0.85rem;
  }
  .dim-summary {
    color: var(--text-secondary);
    margin: 0 0 1rem;
    font-size: 0.96rem;
  }
  .dim-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .dim-metrics li {
    font-size: 0.78rem;
    padding: 0.24rem 0.65rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-secondary);
  }

  /* Whitelist Stage */
  .whitelist-stage {
    padding: clamp(1.8rem, 4vw, 3.2rem);
    border-color: rgba(52, 211, 153, 0.25);
  }
  .whitelist-badge {
    display: inline-block;
    font-size: 0.72rem;
    color: var(--spectrum-emerald);
    margin-bottom: 0.9rem;
  }
  .whitelist-copy {
    color: var(--text-secondary);
    max-width: 72ch;
    margin: 1rem 0 1.8rem;
  }
  .whitelist-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Asymmetric Topics Mosaic */
  .topics-mosaic {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .topics-mosaic {
      grid-template-columns: repeat(6, 1fr);
    }
    .topic-tile {
      grid-column: span 2;
    }
    .topic-tile.tile-wide {
      grid-column: span 3;
    }
  }
  .topic-tile {
    padding: 1.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    border-top: 2px solid var(--tile-accent);
  }
  .topic-code {
    font-size: 0.72rem;
    color: var(--tile-accent);
  }
  .topic-title {
    margin: 0;
    font-size: 1.3rem;
  }
  .topic-desc {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-secondary);
    flex: 1;
  }
  .topic-kw {
    font-size: 0.74rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .articles-strip {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .articles-strip {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .article-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .article-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .article-title {
    margin: 0;
    font-size: 1.12rem;
    line-height: 1.4;
  }
  .article-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    flex: 1;
  }
  .article-more {
    font-size: 0.78rem;
    color: var(--spectrum-accent);
  }
</style>
