---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — 页面未找到" description="您访问的页面不存在或已迁移。" noindex={true}>
  <section class="not-found">
    <div class="container" style="text-align: center; padding: 6rem 0;">
      <div class="eyebrow" style="justify-content: center;">ERROR 404 · SPECTRUM SIGNAL LOST</div>
      <h1 class="display-xl" style="margin: 1rem 0;">页面未找到</h1>
      <p style="color: var(--text-secondary); margin-bottom: 2rem;">该路由不存在或已调整，请返回首页或使用全文检索。</p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary">返回首页</a>
        <a href="/search/" class="btn">全文搜索</a>
      </div>
    </div>
  </section>
</BaseLayout>
